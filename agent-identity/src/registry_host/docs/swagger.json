{
    "swagger": "2.0",
    "info": {
        "description": "This is the API documentation for the Agent Identity Registry.",
        "title": "Agent Identity Registry API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/agent-collections": {
            "get": {
                "description": "Retrieves all available agent collections",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AgentCollection"
                ],
                "summary": "List agent collections",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/responses.AgentCollectionResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/agent/ens/{ensDomain}": {
            "get": {
                "description": "Retrieves a minted agent by its ENS domain name",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent"
                ],
                "summary": "Get agent by ENS domain",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ENS domain name",
                        "name": "ensDomain",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentResponse"
                        }
                    },
                    "404": {
                        "description": "Agent not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/agent/{agentCollectionAddress}/{agentCollectionTokenId}": {
            "get": {
                "description": "Retrieves details of a specific agent by collection address and token ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent"
                ],
                "summary": "Get agent",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Agent collection address",
                        "name": "agentCollectionAddress",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Agent collection token ID",
                        "name": "agentCollectionTokenId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentResponse"
                        }
                    },
                    "404": {
                        "description": "Agent not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/agents": {
            "get": {
                "description": "Retrieves a paginated list of agents with optional filtering",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Agent"
                ],
                "summary": "List agents",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Elements per page",
                        "name": "elementsPerPage",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort direction (asc, desc)",
                        "name": "sortDirection",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort by field",
                        "name": "sortBy",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Filter on mint state (true = minted only, false = proposals only)",
                        "name": "isMinted",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.ListAgentsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "responses.AgentCollectionResponse": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                }
            }
        },
        "responses.AgentResponse": {
            "type": "object",
            "properties": {
                "addresses": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "attributes": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "cloneOf": {
                    "type": "integer"
                },
                "collectionAddress": {
                    "type": "string"
                },
                "collectionTokenId": {
                    "type": "integer"
                },
                "creator": {
                    "type": "string"
                },
                "ensDomain": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "images": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "owner": {
                    "type": "string"
                },
                "proposalId": {
                    "type": "integer"
                }
            }
        },
        "responses.ListAgentsResponse": {
            "type": "object",
            "properties": {
                "agents": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/responses.AgentResponse"
                    }
                },
                "elementsPerPage": {
                    "type": "integer"
                },
                "page": {
                    "type": "integer"
                },
                "totalElements": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}