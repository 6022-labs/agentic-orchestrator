    "paths": {
        "/agent-collections": {
            "get": {
                "description": "Retrieves all available agent collections",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/responses.AgentCollectionResponse"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "List agent collections",
                "tags": [
                    "AgentCollection"
                ]
            }
        },
        "/agent/ens/{ensDomain}": {
            "get": {
                "description": "Retrieves a minted agent by its ENS domain name",
                "parameters": [
                    {
                        "description": "ENS domain name",
                        "in": "path",
                        "name": "ensDomain",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.AgentResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Agent not found"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Get agent by ENS domain",
                "tags": [
                    "Agent"
                ]
            }
        },
        "/agent/{agentCollectionAddress}/{agentCollectionTokenId}": {
            "get": {
                "description": "Retrieves details of a specific agent by collection address and token ID",
                "parameters": [
                    {
                        "description": "Agent collection address",
                        "in": "path",
                        "name": "agentCollectionAddress",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Agent collection token ID",
                        "in": "path",
                        "name": "agentCollectionTokenId",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.AgentResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Get agent",
                "tags": [
                    "Agent"
                ]
            }
        },
        "/agents": {
            "get": {
                "description": "Retrieves a paginated list of agents with optional filtering",
                "parameters": [
                    {
                        "description": "Page number",
                        "in": "query",
                        "name": "page",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "description": "Elements per page",
                        "in": "query",
                        "name": "elementsPerPage",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "description": "Sort direction (asc, desc)",
                        "in": "query",
                        "name": "sortDirection",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Sort by field",
                        "in": "query",
                        "name": "sortBy",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
