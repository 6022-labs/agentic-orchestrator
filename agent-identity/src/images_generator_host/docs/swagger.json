{
    "swagger": "2.0",
    "info": {
        "description": "This is the API for the orchestrator images generator host.",
        "title": "Orchestrator images generator Host API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/generate-images": {
            "post": {
                "description": "Generates images based on the request payload",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "images"
                ],
                "summary": "Generate images",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Base image file",
                        "name": "baseImageBytes",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "baseImageMimeType",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "creator",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "ensDomain",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "name",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "originEnsDomain",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "name": "originGeneration",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "name": "role",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "name": "stars",
                        "in": "formData"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "csv",
                        "name": "wallets",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.GenerateImagesResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "responses.GenerateImagesResponse": {
            "type": "object",
            "properties": {
                "images": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                }
            }
        }
    }
}