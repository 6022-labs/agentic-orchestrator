{
  "title": "Agentic \u2014 Cache",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "agentic",
    "cache"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(deployment_environment_name)",
          "refId": "environment"
        },
        "definition": "label_values(deployment_environment_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(service_name)",
          "refId": "service"
        },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Cache hit ratio by cache",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service_name, cache_name) (rate(cache_result_total{deployment_environment_name=~\"$environment\", service_name=~\"$service\", result=\"hit\"}[5m]))\n  or 0 * sum by (service_name, cache_name) (rate(cache_result_total{deployment_environment_name=~\"$environment\", service_name=~\"$service\"}[5m])))\n/ clamp_min(sum by (service_name, cache_name) (rate(cache_result_total{deployment_environment_name=~\"$environment\", service_name=~\"$service\"}[5m])), 0.001)",
          "legendFormat": "{{service_name}} {{cache_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lookup rate by cache and result",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, cache_name, result) (rate(cache_result_total{deployment_environment_name=~\"$environment\", service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{service_name}} {{cache_name}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Miss rate by cache",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, cache_name) (rate(cache_result_total{deployment_environment_name=~\"$environment\", service_name=~\"$service\", result=\"miss\"}[5m]))",
          "legendFormat": "{{service_name}} {{cache_name}}"
        }
      ]
    }
  ]
}
