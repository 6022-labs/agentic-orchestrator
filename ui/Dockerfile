FROM node:20-alpine3.22 AS build

WORKDIR /app

COPY package.json ./

RUN npm install

ENV PATH=/app/node_modules/.bin:$PATH

# Declare ARGs for your environment variables
ARG VITE_CHAIN_ID
ARG VITE_ENVIRONMENT
ARG VITE_IPFS_GATEWAY
ARG VITE_SCANNER_BASE_URL
ARG VITE_APP_KIT_PROJECT_ID
ARG VITE_OPENSEA_VIEW_URL_TEMPLATE
ARG VITE_RARIBLE_VIEW_URL_TEMPLATE
ARG VITE_AGENT_COLLECTION_CREATOR_ADDRESS
ARG VITE_ORCHESTRATOR_GATEWAY_API_BASE_URL
ARG VITE_AGENT_COLLECTIONS_MANAGER_ADDRESS

# Create .env file and write the environment variables to it
RUN echo "VITE_APP_KIT_PROJECT_ID=${VITE_APP_KIT_PROJECT_ID}" >> .env && \
    echo "VITE_CHAIN_ID=${VITE_CHAIN_ID}" >> .env && \
    echo "VITE_ENVIRONMENT=${VITE_ENVIRONMENT}" >> .env && \
    echo "VITE_IPFS_GATEWAY=${VITE_IPFS_GATEWAY}" >> .env && \
    echo "VITE_SCANNER_BASE_URL=${VITE_SCANNER_BASE_URL}" >> .env && \
    echo "VITE_OPENSEA_VIEW_URL_TEMPLATE=${VITE_OPENSEA_VIEW_URL_TEMPLATE}" >> .env && \
    echo "VITE_RARIBLE_VIEW_URL_TEMPLATE=${VITE_RARIBLE_VIEW_URL_TEMPLATE}" >> .env && \
    echo "VITE_AGENT_COLLECTION_CREATOR_ADDRESS=${VITE_AGENT_COLLECTION_CREATOR_ADDRESS}" >> .env && \
    echo "VITE_ORCHESTRATOR_GATEWAY_API_BASE_URL=${VITE_ORCHESTRATOR_GATEWAY_API_BASE_URL}" >> .env && \
    echo "VITE_AGENT_COLLECTIONS_MANAGER_ADDRESS=${VITE_AGENT_COLLECTIONS_MANAGER_ADDRESS}" >> .env

COPY . .

RUN npm run build

FROM nginx:1.29-alpine3.22

COPY ./nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /var/www/html/

EXPOSE 3000

ENTRYPOINT ["nginx","-g","daemon off;"]