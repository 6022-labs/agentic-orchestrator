HOST__API_PORT=3000 # Default: 3000
HOST__BODY_LIMIT_BYTES=4194304 # Default: 4194304 (4MB)

DATABASE__URL=postgres://localhost:5432/orchestrator
# Optional: PEM of the CA that signed the server certificate; when set, TLS is required and verified
DATABASE__CA_CERTIFICATE=
# Optional, needs DATABASE__CA_CERTIFICATE. Default: the DATABASE__URL host
DATABASE__TLS_SERVER_NAME=

REDIS__HOST=localhost:6379
REDIS__DB=0
REDIS__PASSWORD=

MIGRATIONS__FOLDER_PATH=./migrations

AGENT_IDENTITY_REGISTRY__BASE_URL=http://localhost:5005
AGENT_IDENTITY_REGISTRY__REQUEST_TIMEOUT_SECONDS=30 # Default: 30

BRIDGE_CALLBACK__REQUEST_TIMEOUT_SECONDS=30 # Default: 30

WALLET__PRIVATE_KEY=

BLOCKCHAIN__CHAIN_ID=80002 # Required (80002 = polygon-amoy, 137 = polygon-mainnet)

RPC_NODE__HTTP_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key
RPC_NODE__REQUEST_TIMEOUT_SECONDS=10 # Default: 10

AGENT_ENS_REGISTRY__SMART_CONTRACT_ADDRESS= # Default: built-in well-known address for BLOCKCHAIN__CHAIN_ID

REMOTE_AGENT__REQUEST_TIMEOUT_SECONDS=120 # Default: 120
REMOTE_AGENT__WELL_KNOWN_REQUEST_TIMEOUT_SECONDS=10 # Default: 10

REMOTE_AGENT_RESOLUTION__CACHE_TTL_SECONDS=300 # Default: 300

REGISTRY_AGENT_RESOLUTION__CACHE_TTL_SECONDS=120 # Default: 120

PROCESSING__PARTICIPANT_PROCESSING_INTERVAL=20 # Default: 20
PROCESSING__FACILITATOR_TICK_INTERVAL=30 # Default: 30
PROCESSING__CONVERSATION_FORCE_CONCLUDE_BY_FACILITATOR_AFTER=300 # Default: 300
PROCESSING__CONVERSATION_FORCE_CONCLUDE_AFTER=600 # Default: 2x facilitator delay
PROCESSING__TICK_INTERVAL_SECONDS=1 # Default: 1
PROCESSING__LEASE_DURATION_SECONDS=60 # Default: 60, how long a crashed broker keeps an agent
PROCESSING__MAX_CONCURRENT_PARTICIPANTS=200 # Default: 200, agents processed at once
PROCESSING__MAX_CONCURRENT_CONVERSATIONS=50 # Default: 50, conversations at once per agent

X402_PAYMENT__SIGNATURE_LIFETIME_SECONDS=300
X402_PAYMENT__CLOCK_DRIFT_TOLERANCE_SECONDS=60
X402_PAYMENT__CHALLENGE_CACHE_TTL_SECONDS=300

TELEMETRY__ENABLED=false
# grpc (default) or http; endpoint stays host:port (collector 4317 for grpc, 4318 for http).
TELEMETRY__PROTOCOL=
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
# A token means bearer auth, a username + password means basic auth; setting both is fatal.
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=
