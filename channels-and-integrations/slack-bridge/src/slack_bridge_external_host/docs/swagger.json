{
    "swagger": "2.0",
    "info": {
        "description": "This is the API documentation for the Slack Bridge External Host.",
        "title": "Slack Bridge External API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/command-handler/add-agent-to-channel": {
            "post": {
                "description": "Handles the Slack command to add an agent to a channel by collection address and token ID",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "Command"
                ],
                "summary": "Add agent to channel",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Slack channel ID",
                        "name": "channel_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Command text: [collection address] [token ID]",
                        "name": "text",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Slack user ID",
                        "name": "user_id",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ephemeral reply: success, usage hint on malformed text, or failure notice",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/command-handler/list-agents-in-channel": {
