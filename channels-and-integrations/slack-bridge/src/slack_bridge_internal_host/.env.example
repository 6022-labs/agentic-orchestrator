DATABASE__URL=

HOST__API_PORT=3000 # Default: 3000
HOST__BODY_LIMIT_BYTES=4194304 # Default: 4194304 (4MB)

REDIS__HOST=
REDIS__DB=
REDIS__PASSWORD=

SLACK__APP_ID=
SLACK__API_BASE_URL=https://slack.com # Optional, default is https://slack.com
SLACK__CLIENT_SECRET=
SLACK__SIGNING_SECRET=
SLACK__BOT_TOKEN=
SLACK__ACCEPTED_CHANNEL_PREFIX=ai

IPFS_GATEWAY__URL_TEMPLATE=https://ipfs.io/ipfs/%s # Optional, default is https://ipfs.io/ipfs/%s

MIGRATIONS__FOLDER_PATH=

CONVERSATION_BROKER__BASE_URL=
CONVERSATION_BROKER__CALLBACK_URL=
CONVERSATION_BROKER__BRIDGE_ID=
CONVERSATION_BROKER__REQUEST_TIMEOUT_SECONDS=30 # Default: 30

TELEMETRY__ENABLED=false
# grpc (default) or http; endpoint stays host:port (collector 4317 for grpc, 4318 for http).
TELEMETRY__PROTOCOL=
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
# A token means bearer auth, a username + password means basic auth; setting both is fatal.
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=
