{
    "swagger": "2.0",
    "info": {
        "description": "This is the API documentation for the Slack Bridge Internal Host.",
        "title": "Slack Bridge Internal API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/broker/callback": {
            "post": {
                "description": "Receives an agent completion from the conversation broker and posts it to the originating Slack thread.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "BrokerCallback"
                ],
                "summary": "Conversation broker completion callback",
                "parameters": [
                    {
                        "description": "Broker callback payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.PostBrokerCompletionToSlackRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/errors.NotFoundError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    }
                }
            }
        },
        "/wallet/set-ownership-to-slack-user": {
            "post": {
                "description": "Confirms wallet ownership for a Slack user by providing a signed challenge",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Wallet"
                ],
                "summary": "Set wallet ownership to Slack user",
                "parameters": [
                    {
                        "description": "Wallet ownership verification",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.SetWalletOwnershipToSlackUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/errors.InternalError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "errors.InternalError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "errors.NotFoundError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "errors.ValidationError": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "requests.PostBrokerCompletionToSlackRequest": {
            "type": "object",
            "properties": {
                "collectionAddress": {
                    "type": "string"
                },
                "collectionTokenId": {
                    "type": "integer"
                },
                "content": {
                    "type": "string"
                },
                "conversationId": {
                    "type": "string"
                }
            }
        },
        "requests.SetWalletOwnershipToSlackUserRequest": {
            "type": "object",
            "properties": {
                "challenge": {
                    "type": "string"
                },
                "walletAddress": {
                    "type": "string"
                }
            }
        }
    }
}