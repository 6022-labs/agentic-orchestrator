                                }
                            }
                        },
                        "description": "Not Found"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/errors.InternalError"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Conversation broker completion callback",
                "tags": [
                    "BrokerCallback"
                ]
            }
        },
