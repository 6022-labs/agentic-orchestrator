    "paths": {
        "/agent-collections": {
            "get": {
                "description": "Retrieves all available agent collections",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/responses.AgentCollectionResponse"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "List agent collections",
                "tags": [
                    "agent-collections"
                ]
            }
        },
        "/agent/{agentCollectionAddress}/{agentCollectionTokenId}": {
            "get": {
                "description": "Retrieves details of a specific agent",
                "parameters": [
                    {
                        "description": "collection address",
                        "in": "path",
                        "name": "agentCollectionAddress",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "token id",
                        "in": "path",
                        "name": "agentCollectionTokenId",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.AgentResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Get agent information",
                "tags": [
                    "agent"
                ]
            }
        },
