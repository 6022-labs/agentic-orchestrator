HOST__API_PORT=5001 # Default: 5001
HOST__BODY_LIMIT_BYTES=4194304 # Default: 4194304 (4MB)

REDIS__HOST=localhost:6379
REDIS__DB=0
REDIS__PASSWORD=

JWT__HASH=
JWT__NONCE_TTL=300
JWT__LIVING_TIME=86400
JWT__REFRESH_TTL=604800 # Default: 604800 (7 days)
JWT__REFRESH_IDLE_TTL=172800 # Default: 86400 (1 day); at least twice JWT__LIVING_TIME

RATE_LIMIT__REQUESTS_PER_SECOND=50
PROXY__HEADER= # optional, e.g. X-Forwarded-For; honored only from PROXY__TRUSTED_PROXIES
PROXY__TRUSTED_PROXIES= # optional, comma-separated IPs or CIDR ranges; the Docker image trusts 127.0.0.1 + private ranges, keep 127.0.0.1 when overriding

AGENT_IDENTITY_REGISTRY__BASE_URL=http://localhost:5005

CONVERSATION_BROKER__BASE_URL=http://localhost:5004
CONVERSATION_BROKER__REQUEST_TIMEOUT_SECONDS=30 # Default: 30
PLATFORM_BRIDGES__SLACK_BRIDGE__BASE_URL=http://localhost:5101
PLATFORM_BRIDGES__SLACK_BRIDGE__REQUEST_TIMEOUT_SECONDS=30 # Default: 30

CONSOLE__URL=http://localhost:5173 # Required: the console's public URL
CORS__ALLOW_ORIGINS= # optional, comma-separated, defaults to the CONSOLE__URL origin; * allows any
SIWE__STATEMENT= # optional, has a default

TELEMETRY__ENABLED=false
# grpc (default) or http; endpoint stays host:port (collector 4317 for grpc, 4318 for http).
TELEMETRY__PROTOCOL=
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
# A token means bearer auth, a username + password means basic auth; setting both is fatal.
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=
