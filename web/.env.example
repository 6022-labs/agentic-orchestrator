# Vite: read when the bundle is built (npm run dev / npm run build)
VITE_APP_KIT_PROJECT_ID=
VITE_ENVIRONMENT=

VITE_GATEWAY_API_BASE_URL=/api # Default: /api (dev proxy / nginx)

VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Fallbacks when GET /config does not provide the contract addresses
VITE_AGENT_COLLECTIONS_MANAGER_ADDRESS=
VITE_AGENT_COLLECTION_CREATOR_ADDRESS=

# nginx: read when the container starts
# Gateway that /api forwards to: scheme and host, no path
GATEWAY__BASE_URL=http://gateway-host:5000
