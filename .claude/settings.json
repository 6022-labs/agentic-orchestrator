{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(go vet *)",
      "Bash(go mod *)",
      "Bash(go run *)",
      "Bash(go test *)",
      "Bash(go test:*)",
      "Bash(go list *)",
      "Bash(go build:*)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mockgen *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(railway logs *)",
      "Bash(railway status)",
      "Bash(railway whoami)",
      "Bash(railway list)",
      "Read",
      "Write",
      "Edit"
    ],
    "ask": ["Bash(* > *)", "Bash(* >> *)", "Bash(* | tee *)"],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(find * -delete)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/credentials*)",
      "Read(~/.claude/**)",

      "Write(**/.env*)",
      "Edit(**/.env*)",
      "Write(.claude/settings*.json)",
      "Edit(.claude/settings*.json)",
      "Write(.mcp.json)",
      "Edit(.mcp.json)"
    ]
  }
}
